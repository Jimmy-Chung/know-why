# 复制为 .env 后使用：cp .env.example .env
# docker compose 会自动读取项目根目录的 .env；该文件不入库。

# 访问口令（必填，建议 12 位以上）。
# 浏览器首次打开会弹出登录框，用户名随便填（如 knowknow），密码填这里的值。
KNOW_KNOW_AUTH_PASSWORD=change-me-please

# ---- 以下通常不用改 ----

# 反向代理改写了 Host（例如容器化 Nginx）时才需要显式列出站点来源
# KNOW_KNOW_ALLOWED_ORIGINS=https://know.example.com
# KNOW_KNOW_TRUST_PROXY=1

# 关闭本地向量检索：省掉约 448MB 模型下载，知识助手退回纯关键词检索
# KNOW_KNOW_EMBEDDINGS=off
