{
  "name": "know-know",
  "version": "1.4.0",
  "private": true,
  "description": "Know Know — 以知识探索分支组织对话的个人本机 AI 应用（1.0，无登录）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json && vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "start": "tsx src/server/index.ts",
    "start:prod": "node dist-server/server/index.js",
    "migrate": "tsx src/server/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@floating-ui/react": "^0.27.20",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.1",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^11.3.0",
    "dompurify": "^3.4.18",
    "hono": "^4.6.0",
    "katex": "^0.18.6",
    "keytar": "^7.9.0",
    "marked": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
